CHKSUMS=(SKIP)
SUBDIR=SOURCE/EDIT

PKGNAME=edit
BUILDDEP=(open-watcom)

build() {
    find . -type f -exec 'bash' '-ec' 'F={};FL=${F,,};mv -v $F $FL;' ';'
    wcl ./*.c -I/opt/ow/h/ -I. -fo=.obj -oh -j -3
}