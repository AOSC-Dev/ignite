# shellcheck shell=bash
VER=2046
SRCS=(
    "tbl::https://github.com/FDOS/kernel/releases/download/ke${VER}/kernel.zip"
)
CHKSUMS=(
    'sha256::a62a767a6cccbff0fc1072ab21aa8fd520d6a8b14e1b935e60e84a2fb48b6d0a'
)
SUBDIR=SOURCE/KERNEL

PKGNAME=freedos-kernel
BUILDDEP=(
    open-watcom
    nasm
    make
)

build() {
    make all COMPILER=owlinux
    install -Dvm644 bin/country.sys "$PKGDIR"/COUNTRY.SYS
    install -Dvm644 bin/kernel.sys "$PKGDIR"/KERNEL.SYS
    install -Dvm644 bin/setver.sys "$PKGDIR"/SETVER.SYS
    install -Dvm755 bin/sys.com "$PKGDIR"/SYS.COM
}
