[COMMON]
; Set last drive letter to Z:.
!LASTDRIVE=Z
; Load DOS in high memory segment (640KiB ~ 1MiB).
DOS=HIGH
; Load extended memory service (XMS).
DEVICE=\FREEDOS\BIN\XMGR.SYS
; Set DOS command prompt.
SHELL=\FREEDOS\BIN\COMMAND.COM \FREEDOS\BIN /E:2048 /P=\FDAUTO.BAT

[MENU]
MENUITEM=AGINSTLL,Install Afterglow
MENUITEM=AGDOSSHL,Start the Utilities Diskette
; 30-second delay before booting from AGINSTLL.
MENUDEFAULT=AGINSTLL,30

[AGINSTLL]
; Driver for optical drives.
DEVICEHIGH=\FREEDOS\BIN\UDVD2.SYS /D:MSCD000

[AGDOSSHL]
