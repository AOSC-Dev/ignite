; Set last drive letter to Z:.
!LASTDRIVE=Z
!BUFFERS=20
!FILES=40
!MENUCOLOR=7,0

; 30-second delay before booting from AGINSTLL.
MENUDEFAULT=2,30
MENU 
MENU Afterglow Boot Menu (DOS)
MENU 
MENU 1 - Install Afterglow
MENU 2 - Start the Utilities Diskette
MENU

; Load DOS in high memory segment (640KiB ~ 1MiB).
12?DOS=HIGH,UMB
12?DOSDATA=UMB
; Load extended memory service (XMS).
12?DEVICE=\FREEDOS\BIN\XMGR.SYS
; Driver for optical drives.
12?DEVICEHIGH=\FREEDOS\BIN\UDVD2.SYS /D:MSCD000
; Set DOS command prompt.
12?SHELLHIGH=\FREEDOS\BIN\COMMAND.COM \FREEDOS\BIN /E:2048 /P=\FDAUTO.BAT
