# shellcheck shell=bash
VER=2.11d
SRCS=(git::commit=04ba2258d64e2dc0706f0c964c66bd788e05d920::https://gitlab.com/FreeDOS/disk/dosfsck/
    # TODO: build DOS extender from source
    "tbl::https://sandmann.dotster.com/cwsdpmi/csdpmi7b.zip"
)
CHKSUMS=(SKIP
"sha256::deacda0488e1cdd7c4a9f32fab45662b34c0ed6b2d7d4d13bc07041b62004a8c")
SUBDIR=SOURCE/DOSFSCK

PKGNAME=dosfsck
BUILDDEP=(djgpp-gcc upx make)

build() {
    mv INC inc
    find . -type f -exec 'bash' '-ec' 'F={};FL=${F,,};mv -v $F $FL;' ';'
    make CC=i586-pc-msdosdjgpp-gcc CFLAGS='-O2 -fomit-frame-pointer -ffunction-sections -fdata-sections'
    i586-pc-msdosdjgpp-strip -s dosfsck
    # Pre-pack the dosfsck COFF binary
    # if done after inserting the extender, UPX will not be able to compress the binary
    upx --coff --best dosfsck
    # "Infect" the program with the DOS extender
    cat ../../bin/CWSDSTUB.EXE dosfsck > dosfsck.exe
    install -Dvm755 dosfsck.exe "$PKGDIR"/DOSFSCK.EXE
}